{
    "name": "treevia",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@10.18.2",
    "scripts": {
        "dev": "pnpm --parallel --filter './apps/*' dev",
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "start": "pnpm --filter @treevia/api start",
        "db:up": "docker compose up -d db",
        "db:down": "docker compose down",
        "db:logs": "docker compose logs -f db",
        "db:push": "pnpm --filter @treevia/api db:push",
        "db:generate": "pnpm --filter @treevia/api db:generate",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "prettier": "^3.5.3"
    },
    "dependencies": {
        "framer-motion": "^13.4.0"
    }
}
